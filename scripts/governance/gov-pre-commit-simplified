#!/usr/bin/env bash
#
# Git pre-commit hook — 精简版（项目自有）
# 检查: 分支约束 + 会话归属 + 编译 + gov-custom-checks（含 gov-code-check）
# 跳过: git commit --no-verify
# 安装: cp scripts/governance/gov-pre-commit-simplified .git/hooks/pre-commit
#       （勿用会装回模板长版的 bs-install-hooks.sh，直至其改指向本文件）

set -euo pipefail

# ---- 治理总开关（scripts/governance/gov-mode.sh off 时直接放行）----
_gov_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=/dev/null
if [ -f "$_gov_root/scripts/governance/gov-mode.sh" ]; then
  . "$_gov_root/scripts/governance/gov-mode.sh"
  if gov_mode_is_off; then
    gov_mode_audit_skip "pre-commit"
    gov_mode_banner "pre-commit"
    exit 0
  fi
fi

# DEC-050: worktree 共享 .git/hooks 时，$0 回推会指到主树；优先 show-toplevel
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT:-}" ] || [ ! -f "$ROOT/scripts/governance/gov-custom-checks.sh" ]; then
  ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi
cd "$ROOT"
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo ".git")
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# =============================================================
# 0. 多会话守卫: 主共享树 + 并发会话 → 强制 worktree（DEC-054）
#    根因: 所有会话共享 .git，HEAD/配置是全局的，互相覆盖 —— 抢分支、
#    提交落错分支、core.bare 被误设致 git 不可用。worktree 各有独立
#    HEAD/工作区（只共享对象库），从结构上免疫。
#    检测: 在主树(git-dir==git-common-dir) 且 context.jsonl 近 2h 有
#    >=2 个不同 session-start → 判定并发。逃生口: ALLOW_MAIN_TREE=1。
# =============================================================
GD="$(git rev-parse --git-dir 2>/dev/null || echo '')"
GCD="$(git rev-parse --git-common-dir 2>/dev/null || echo '')"
if [ -n "$GD" ] && [ "$GD" = "$GCD" ] && [ "${ALLOW_MAIN_TREE:-0}" != "1" ]; then
  CTX="$ROOT/.cache/context.jsonl"
  if [ -f "$CTX" ]; then
    RECENT=$(python3 - "$CTX" <<'PY'
import json,sys,time,datetime
ids=set(); now=time.time()
try:
    for line in open(sys.argv[1],encoding='utf-8'):
        line=line.strip()
        if not line: continue
        try: e=json.loads(line)
        except: continue
        if e.get('type')!='session-start': continue
        try: t=datetime.datetime.fromisoformat(e.get('ts','').replace('Z','+00:00')).timestamp()
        except: continue
        # 按 session_id 去重：同一会话多次跑 session-begin 只是"启动了几次"，
        # 不是"几个会话在并发"。旧格式记录没有该字段，回退按 id（保守）。
        if now-t<=7200: ids.add(e.get('session_id') or e.get('id') or e.get('ts'))
    print(len(ids))
except Exception: print(0)
PY
)
    if [ "${RECENT:-0}" -ge 2 ]; then
      echo "❌ 检测到并发会话（近 2h 有 ${RECENT} 个 session-start），当前在主共享树。"
      echo "   主树抢 HEAD/配置会导致提交落错分支、core.bare 污染等（DEC-054）。"
      echo "   请改用隔离 worktree: bash scripts/session/ses-worktree.sh add feat/<topic>"
      echo "   （确认你是唯一会话时可临时: ALLOW_MAIN_TREE=1 git commit）"
      exit 1
    fi
  fi
fi

# =============================================================
# 1. 分支约束: master 只允许 merge
# =============================================================
if [ "$BRANCH" = "master" ]; then
  if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
    echo "❌ 禁止在 master 上直接提交（请用分支 + merge）"
    exit 1
  fi
fi

# =============================================================
# 2. 会话归属: 防止跨会话误提交
# =============================================================
SESSION_FILE="$ROOT/.ai/current-session.json"
CLAIM_FILE="$ROOT/.ai/staged-claims.json"

if [ -f "$SESSION_FILE" ] && [ -f "$CLAIM_FILE" ]; then
  CURRENT_SESSION=$(python3 -c "
import json
try:
    with open('$SESSION_FILE') as f: print(json.load(f).get('session_id',''))
except: print('')
" 2>/dev/null)
  if [ -n "$CURRENT_SESSION" ]; then
    UNCLAIMED=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
      [ -z "$f" ] && continue
      CLAIMED=$(python3 -c "
import json
try:
    with open('$CLAIM_FILE') as f:
        d = json.load(f)
    print(d.get('$f',''))
except: print('')
" 2>/dev/null)
      if [ "$CLAIMED" != "$CURRENT_SESSION" ]; then
        echo "$f"
      fi
    done)
    if [ -n "$UNCLAIMED" ]; then
      echo "❌ 以下文件未声明归属给当前会话:"
      echo "$UNCLAIMED" | head -5
      echo "   声明: bash scripts/session/ses-claim-staged.sh"
      exit 1
    fi
  fi
fi

# =============================================================
# 2b. 任务锁软校验 (DEC-064): 暂存文件命中某任务 target_files 且锁被
#     其他会话持有时拒绝提交；锁不存在不拦（认领是推荐，非强制）。
# =============================================================
CLAIM_SCRIPT="$ROOT/scripts/workflow/wf-claim.sh"
if [ -f "$CLAIM_SCRIPT" ] && [ -f "$ROOT/.ai/tasks.json" ]; then
  if ! bash "$CLAIM_SCRIPT" --root "$ROOT" --check-staged; then
    exit 1
  fi
fi

# =============================================================
# 3. 源码变更？→ 编译 + custom-checks（含 gov-code-check）
# =============================================================
# =============================================================
# 3c. 禁止绕过（DEC-070）：手工建树 / 手工跨分支合并一律拒绝
#     任何"绕过工具"的动作都会重新引入已修过的坑（缺 local.properties、
#     共享状态冲突、错误证据）。能用钩子拦的，不靠自觉。
# =============================================================
GD="$(git rev-parse --git-dir 2>/dev/null || true)"
GCD="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$GD" ] && [ "$GD" != "$GCD" ] && [ "${ALLOW_UNREGISTERED_WORKTREE:-0}" != "1" ]; then
  WT_PATH="$(git rev-parse --show-toplevel 2>/dev/null)"
  # DEC-063 之后依赖走共享 GRADLE_USER_HOME，worktree 不再需要自己的 gradle/dists；
  # 继续要求它会让每个新建 worktree 都无法提交（实测）。
  if [ ! -f "$WT_PATH/local.properties" ]; then
    echo "❌ 本 worktree 缺引导文件（local.properties）"
    echo "   说明它未经 ses-worktree.sh 创建；请删掉重建："
    echo "   bash scripts/session/ses-worktree.sh remove "$WT_PATH" && bash scripts/session/ses-worktree.sh add <type>/<topic>"
    exit 1
  fi
fi

if [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]; then
  case "$BRANCH" in
    chore/integration-*|chore/board-*|chore/fix-*) : ;;  # 队列/收尾分支允许
    *)
      UNEXPECTED=0
      for parent in $(git rev-parse MERGE_HEAD 2>/dev/null); do
        git merge-base --is-ancestor "$parent" origin/master 2>/dev/null || UNEXPECTED=1
      done
      if [ "$UNEXPECTED" -eq 1 ]; then
        echo "❌ 禁止手工跨分支合并（合并只允许通过 wf-queue.sh）"
        echo "   撤销: git merge --abort"
        echo "   正确做法: bash scripts/workflow/wf-queue.sh run --lanes auto <branch>"
        exit 1
      fi
      ;;
  esac
fi


# DEC-067: 合并提交（MERGE_HEAD 存在）是集成动作，不引入新源码语义——
# 编译/自定义检查由合入门禁（local-ci）负责，此处跳过，避免每个合并分支冷编译 1-3 分钟。
if [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]; then
  echo "  (合并提交: 跳过编译与 custom-checks，合入门禁仍会校验)"
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)

# =============================================================
# 3b. 共享状态保护（DEC-067）：派生数据只允许合并队列/收尾自动化写。
#     功能分支手改 = 每次合并必冲突（2026-10-24 实测 5 轮）。
#     共享文件修改需持 lock（DEC-077）, 防并发 AI 震荡。
# =============================================================

SHARED_DERIVED=$(echo "$STAGED" | grep -E '^(\.ai/tasks\.json|STATUS\.md|tests/android-test-registry\.yaml|docs/ai/lifecycle/03_TaskGraph\.md|docs/ai/lifecycle/06_Metrics\.md|docs/index\.md|AGENTS\.md)$' || true)
BOARD_BRANCH=0
case "$BRANCH" in chore/board-*|chore/integration-*) BOARD_BRANCH=1 ;; esac
if [ -n "$SHARED_DERIVED" ] && [ "$BOARD_BRANCH" -eq 0 ]; then
  echo "❌ 禁止在功能分支提交派生数据（单一写者，DEC-064/067）："
  echo "$SHARED_DERIVED" | sed 's/^/    /'
  echo "   取消暂存: git restore --staged <file>"
  echo "   需要同步时执行: bash scripts/governance/gov-board-sync.sh（由合并队列在主干完成）"
  exit 1
fi

# chore/board-* 分支: 共享文件需持锁修改 (DEC-077)
if [ -n "$SHARED_DERIVED" ] && [ "$BOARD_BRANCH" -eq 1 ]; then
  SESSION_ID_CURR="$(cat "$ROOT/.ai/current-session.json" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null || true)"
  for f in $SHARED_DERIVED; do
    if ! bash "$ROOT/scripts/workflow/wf-lock.sh" file-check "$f" 2>/dev/null | grep -q "$SESSION_ID_CURR"; then
      echo "❌ 共享文件 $f 未锁定 (或锁持有者不是当前会话)"
      echo "   请先获取锁: bash scripts/workflow/wf-lock.sh file-acquire \"$f\" --mode docs"
      echo "   释放锁: bash scripts/workflow/wf-lock.sh file-release \"$f\""
      exit 1
    fi
    echo "  ✓ 共享文件锁定: $f"
  done
fi

SRC_CHANGED=$(echo "$STAGED" | grep -E '^(domain|application|infrastructure|app)/.*\.(kt|java)$' || true)
# 治理脚本自身变更也跑 custom-checks（避免改检查器时漏自检）；仍要求与源码相关时才编译
GOV_CHANGED=$(echo "$STAGED" | grep -E '^scripts/governance/(gov-custom-checks\.sh|gov-code-check\.py|gov-pre-commit-simplified)$' || true)

# =============================================================
# 任务画像（DEC-074）：不同任务类型走不同门禁，而不是一律最重
#   docs → 不编译不查源码；test → 只保证脚本语法；gov/code → 原逻辑
# 越界即拒绝：docs 画像改了 src/，说明认领错了画像，必须先重认领。
# 逃生口：GOV_PROFILE_FORCE=1 GOV_PROFILE=mixed（留痕在 profile explain）
# =============================================================
PROFILE="$(bash "$ROOT/scripts/governance/gov-profile.sh" resolve --staged 2>/dev/null || echo mixed)"
echo "  任务画像: $PROFILE"
if ! bash "$ROOT/scripts/governance/gov-profile.sh" check-scope --staged; then
  echo "❌ 暂停提交：改动越出任务画像范围"
  exit 1
fi

# 角色边界（DEC-075）：声明了角色就按角色白名单拦；未声明则只用画像兜底。
ROLE="$(bash "$ROOT/scripts/workflow/wf-role.sh" current 2>/dev/null || true)"
if [ -n "$ROLE" ]; then
  echo "  AI 角色: $ROLE"
  if ! bash "$ROOT/scripts/workflow/wf-role.sh" check-scope --staged; then
    echo "❌ 暂停提交：改动越出角色范围"
    exit 1
  fi
else
  # 默认 fail-closed：改代码/治理脚本却没有角色，等同于"谁都能改"。
  # 放宽方式显式为 GOV_ROLE_REQUIRED=0（会打印，可被评审看到）。
  if [ "${GOV_ROLE_REQUIRED:-1}" = "1" ] && \
     echo "$STAGED" | grep -qE '^(app/src/main|domain/src/main|application/src/main|infrastructure/src/main|scripts)/'; then
    echo "❌ 未声明 AI 角色：本次改动触及代码或治理脚本"
    echo "   先声明角色（一个会话一个角色）:"
    echo "     bash scripts/workflow/wf-role.sh claim dev    # 改产品代码"
    echo "     bash scripts/workflow/wf-role.sh claim gov    # 改治理脚本"
    echo "   临时放宽（需在 PR 里说明理由）: GOV_ROLE_REQUIRED=0 git commit ..."
    exit 1
  fi
  echo "  AI 角色: 未声明（改动不触及代码/脚本，按画像兜底）"
fi

# 画像为 docs 时不做任何源码类检查（文档由 pre-push 的 validate 兜底）
case "$PROFILE" in
  docs)
    SRC_CHANGED=""
    GOV_CHANGED=""
    ;;
  test)
    # 测试画像只查 shell 语法与暂存区范围；跑测试放在交付环
    SRC_CHANGED=""
    ;;
esac

# 改动的 shell 脚本先过语法（毫秒级，任何画像都值得做）
SH_CHANGED=$(echo "$STAGED" | grep -E '^scripts/.*\.sh$' || true)
if [ -n "$SH_CHANGED" ]; then
  for f in $SH_CHANGED; do
    if ! bash -n "$f" 2>/dev/null; then
      echo "❌ shell 语法错误: $f"
      exit 1
    fi
    # $VAR 紧跟中文会被 bash 当成变量名的一部分（set -u 下直接崩）
    # 注意：BSD grep（macOS 默认）不支持 \xHH 转义，旧写法 [^\x00-\x7F] 会被解释成
    # 普通字符集，从而匹配一切、对任何含 $VAR 的行误报（2026-10-27 实测）。
    # 改用 POSIX 的"非可打印 ASCII"范围 [^ -~]，语义等价且跨平台。
    if grep -nE '\$[A-Za-z_][A-Za-z0-9_]*[^ -~]' "$f" >/dev/null 2>&1; then
      echo "❌ $f: 变量后紧跟中文，请写成 \${var}"
      grep -nE '\$[A-Za-z_][A-Za-z0-9_]*[^ -~]' "$f" | head -3
      exit 1
    fi
  done
  echo "  ✓ shell 语法通过（$(echo "$SH_CHANGED" | wc -l | tr -d ' ') 个文件）"
fi

# ---- 模式感知: 读取工作模式 (DEC-077) ----
# 如果 GOV_MODE 环境变量未设置, 从 .ai/current-mode.json 读取 (带 HMAC + 过期)
if [ -z "${GOV_MODE:-}" ] && [ -f "$ROOT/scripts/governance/gov-mode-lib.sh" ]; then
  # shellcheck source=/dev/null
  . "$ROOT/scripts/governance/gov-mode-lib.sh"
  GOV_MODE=$(gov_mode_get 2>/dev/null || true)
fi
GOV_MODE="${GOV_MODE:-dev}"

if [ -n "$SRC_CHANGED" ]; then
  if [ "$GOV_MODE" = "explore" ] || [ "$GOV_MODE" = "docs" ]; then
    echo "  [模式: $GOV_MODE] 跳过 4 模块编译 (审计记录到 .ai/audit/bypass.log)"
    mkdir -p "$ROOT/.ai/audit"
    printf '[%s] session=%s branch=%s mode=%s check=compile_skipped reason="explore/docs模式允许跳过编译" files="%s"\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
      "${SESSION_ID:-unknown}" \
      "$BRANCH" \
      "$GOV_MODE" \
      "$(echo "$SRC_CHANGED" | tr '\n' ' ')" >> "$ROOT/.ai/audit/bypass.log"
  else
    echo "  检测到源码变更，运行编译检查..."
    if ! ./gradlew :domain:compileKotlin :application:compileKotlin :infrastructure:compileDebugKotlin :app:compileDebugKotlin -q; then
      echo "❌ 编译失败，请修复后再提交"
      exit 1
    fi
    echo "  ✓ 编译通过"
  fi
fi

if [ -n "$SRC_CHANGED" ] || [ -n "$GOV_CHANGED" ]; then
  echo "  运行 gov-custom-checks（含 gov-code-check）..."
  if [ ! -f "$ROOT/scripts/governance/gov-custom-checks.sh" ]; then
    echo "❌ 缺少 scripts/governance/gov-custom-checks.sh"
    exit 1
  fi
  # DEC-072: 提交环只查暂存区，全仓扫描留给 local-ci（慢层）
  if ! GOV_CODE_CHECK_STAGED=1 bash "$ROOT/scripts/governance/gov-custom-checks.sh"; then
    echo "❌ gov-custom-checks 失败，提交被拒绝"
    exit 1
  fi
  echo "  ✓ custom-checks 通过"
fi

# DEC-077: 记录"这个提交走过钩子"的证据（按 tree 记）。
# pre-push 用它反查 --no-verify；只覆盖本机提交，属于"可发现"而非"不可绕过"。
TRAIL="$ROOT/.cache/hook-trail.log"
TREE="$(git write-tree 2>/dev/null || true)"
if [ -n "$TREE" ]; then
  mkdir -p "$ROOT/.cache"
  printf '%s %s\n' "$TREE" "$(date +%s)" >> "$TRAIL" 2>/dev/null || true
  tail -n 500 "$TRAIL" > "$TRAIL.tmp" 2>/dev/null && mv "$TRAIL.tmp" "$TRAIL" 2>/dev/null || true
fi

echo "✓ pre-commit 检查通过"
exit 0
