#!/usr/bin/env bash
#
# Git pre-commit hook — 精简版（项目自有）
# 检查: 分支约束 + 会话归属 + 编译 + gov-custom-checks（含 gov-code-check）
# 跳过: git commit --no-verify
# 安装: cp scripts/governance/gov-pre-commit-simplified .git/hooks/pre-commit
#       （勿用会装回模板长版的 bs-install-hooks.sh，直至其改指向本文件）

set -euo pipefail

# DEC-050: worktree 共享 .git/hooks 时，$0 回推会指到主树；优先 show-toplevel
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT:-}" ] || [ ! -f "$ROOT/scripts/governance/gov-custom-checks.sh" ]; then
  ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi
cd "$ROOT"
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo ".git")
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# =============================================================
# 0. 多会话守卫: 主共享树 + 并发会话 → 强制 worktree（DEC-054）
#    根因: 所有会话共享 .git，HEAD/配置是全局的，互相覆盖 —— 抢分支、
#    提交落错分支、core.bare 被误设致 git 不可用。worktree 各有独立
#    HEAD/工作区（只共享对象库），从结构上免疫。
#    检测: 在主树(git-dir==git-common-dir) 且 context.jsonl 近 2h 有
#    >=2 个不同 session-start → 判定并发。逃生口: ALLOW_MAIN_TREE=1。
# =============================================================
GD="$(git rev-parse --git-dir 2>/dev/null || echo '')"
GCD="$(git rev-parse --git-common-dir 2>/dev/null || echo '')"
if [ -n "$GD" ] && [ "$GD" = "$GCD" ] && [ "${ALLOW_MAIN_TREE:-0}" != "1" ]; then
  CTX="$ROOT/.cache/context.jsonl"
  if [ -f "$CTX" ]; then
    RECENT=$(python3 - "$CTX" <<'PY'
import json,sys,time,datetime
ids=set(); now=time.time()
try:
    for line in open(sys.argv[1],encoding='utf-8'):
        line=line.strip()
        if not line: continue
        try: e=json.loads(line)
        except: continue
        if e.get('type')!='session-start': continue
        try: t=datetime.datetime.fromisoformat(e.get('ts','').replace('Z','+00:00')).timestamp()
        except: continue
        if now-t<=7200: ids.add(e.get('id') or e.get('ts'))
    print(len(ids))
except Exception: print(0)
PY
)
    if [ "${RECENT:-0}" -ge 2 ]; then
      echo "❌ 检测到并发会话（近 2h 有 ${RECENT} 个 session-start），当前在主共享树。"
      echo "   主树抢 HEAD/配置会导致提交落错分支、core.bare 污染等（DEC-054）。"
      echo "   请改用隔离 worktree: bash scripts/session/ses-worktree.sh add feat/<topic>"
      echo "   （确认你是唯一会话时可临时: ALLOW_MAIN_TREE=1 git commit）"
      exit 1
    fi
  fi
fi

# =============================================================
# 1. 分支约束: master 只允许 merge
# =============================================================
if [ "$BRANCH" = "master" ]; then
  if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
    echo "❌ 禁止在 master 上直接提交（请用分支 + merge）"
    exit 1
  fi
fi

# =============================================================
# 2. 会话归属: 防止跨会话误提交
# =============================================================
SESSION_FILE="$ROOT/.ai/current-session.json"
CLAIM_FILE="$ROOT/.ai/staged-claims.json"

if [ -f "$SESSION_FILE" ] && [ -f "$CLAIM_FILE" ]; then
  CURRENT_SESSION=$(python3 -c "
import json
try:
    with open('$SESSION_FILE') as f: print(json.load(f).get('session_id',''))
except: print('')
" 2>/dev/null)
  if [ -n "$CURRENT_SESSION" ]; then
    UNCLAIMED=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
      [ -z "$f" ] && continue
      CLAIMED=$(python3 -c "
import json
try:
    with open('$CLAIM_FILE') as f:
        d = json.load(f)
    print(d.get('$f',''))
except: print('')
" 2>/dev/null)
      if [ "$CLAIMED" != "$CURRENT_SESSION" ]; then
        echo "$f"
      fi
    done)
    if [ -n "$UNCLAIMED" ]; then
      echo "❌ 以下文件未声明归属给当前会话:"
      echo "$UNCLAIMED" | head -5
      echo "   声明: bash scripts/session/ses-claim-staged.sh"
      exit 1
    fi
  fi
fi

# =============================================================
# 3. 源码变更？→ 编译 + custom-checks（含 gov-code-check）
# =============================================================
STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
SRC_CHANGED=$(echo "$STAGED" | grep -E '^(domain|application|infrastructure|app)/.*\.(kt|java)$' || true)
# 治理脚本自身变更也跑 custom-checks（避免改检查器时漏自检）；仍要求与源码相关时才编译
GOV_CHANGED=$(echo "$STAGED" | grep -E '^scripts/governance/(gov-custom-checks\.sh|gov-code-check\.py|gov-pre-commit-simplified)$' || true)

if [ -n "$SRC_CHANGED" ]; then
  echo "  检测到源码变更，运行编译检查..."
  if ! ./gradlew :domain:compileKotlin :application:compileKotlin :infrastructure:compileDebugKotlin :app:compileDebugKotlin -q; then
    echo "❌ 编译失败，请修复后再提交"
    exit 1
  fi
  echo "  ✓ 编译通过"
fi

if [ -n "$SRC_CHANGED" ] || [ -n "$GOV_CHANGED" ]; then
  echo "  运行 gov-custom-checks（含 gov-code-check）..."
  if [ ! -f "$ROOT/scripts/governance/gov-custom-checks.sh" ]; then
    echo "❌ 缺少 scripts/governance/gov-custom-checks.sh"
    exit 1
  fi
  if ! bash "$ROOT/scripts/governance/gov-custom-checks.sh"; then
    echo "❌ gov-custom-checks 失败，提交被拒绝"
    exit 1
  fi
  echo "  ✓ custom-checks 通过"
fi

echo "✓ pre-commit 检查通过"
exit 0
