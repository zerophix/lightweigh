#!/usr/bin/env bash
# Git pre-push hook — 分支命名 + 校验必须 PASS + 密钥扫描（DEC-049）
set -euo pipefail

# ---- 治理总开关（scripts/governance/gov-mode.sh off 时直接放行）----
_gov_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=/dev/null
if [ -f "$_gov_root/scripts/governance/gov-mode.sh" ]; then
  . "$_gov_root/scripts/governance/gov-mode.sh"
  if gov_mode_is_off; then
    gov_mode_audit_skip "pre-push"
    gov_mode_banner "pre-push"
    exit 0
  fi
fi

# DEC-050: worktree 下优先 show-toplevel，避免共享 hooks 时 ROOT 落到主树
WORKTREE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# 如果在 worktree 中，WORKTREE_ROOT 是 worktree 路径；需要找到主仓库根目录
ROOT="$WORKTREE_ROOT"
# 检查是否在 worktree 中（存在 .git 文件而非目录）
if [ -f "$WORKTREE_ROOT/.git" ]; then
  # worktree: .git 文件指向主仓库的 .git/worktrees/<name>
  # 获取主仓库根目录
  ROOT="$(git rev-parse --git-common-dir 2>/dev/null | sed 's|/\.git$||')"
fi
# 回退：如果无法确定，用脚本相对路径
if [ -z "${ROOT:-}" ] || [ ! -f "$ROOT/scripts/governance/gov-validate.sh" ]; then
  ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi
cd "$ROOT"
# 分支名从 worktree 获取（而非主仓库），避免推送批次分支时被误判为 master
BRANCH=$(git -C "$WORKTREE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# DEC-077: 钩子 stdin 是一次性的，先收起来供绕过审计使用
PUSH_INPUT=""
if [ ! -t 0 ]; then
  PUSH_INPUT="$(cat)"
fi
VALIDATE_SCRIPT="$ROOT/scripts/governance/gov-validate.sh"

# DEC-064 开发/质量解耦:
# - push 只做秒级检查(分支名 + 文档校验 + 密钥扫描), pytest 移到 local-ci(合入门禁)
# - 墙钟门禁(001/002)已退役, 不再需要删除类 push 的豁免分支
export GOV_VALIDATE_QUICK=1

echo ""
echo "=== pre-push 审计 ==="
# DEC-074: 画像只用于说明本次推送的门禁口径；推送环本身保持秒级
PROFILE="$(bash "$ROOT/scripts/governance/gov-profile.sh" resolve 2>/dev/null || echo mixed)"
ROLE="$(bash "$ROOT/scripts/workflow/wf-role.sh" current 2>/dev/null || true)"
echo "  任务画像: $PROFILE  AI 角色: ${ROLE:-未声明}（测试在交付环/合入环执行）"

# 分支命名
TRUNK_PATTERN='^(main|master|develop)$'
FEATURE_PATTERN='^(feat|fix|docs|refactor|chore|test|ci|batch)/[a-zA-Z0-9][a-zA-Z0-9._-]+$'

if ! echo "$BRANCH" | grep -qE "$TRUNK_PATTERN" && \
   ! echo "$BRANCH" | grep -qE "$FEATURE_PATTERN"; then
  echo "❌ 分支名不符合命名规范: $BRANCH"
  echo "   格式: <type>/<description>  (type: feat|fix|docs|refactor|chore|test|ci|batch)"
  echo "   临时跳过: git push --no-verify"
  exit 1
fi
echo "  [1/4] 分支命名: ✅ $BRANCH"

# validate.sh 必须 PASS — 以退出码判定，不耦合具体输出文案（DEC-005）
FAILED=0
TMPD="$(mktemp -d)"
trap 'rm -rf "$TMPD"' EXIT

# 文档校验与密钥扫描互不依赖：并行跑，省掉约 1.3s 串行等待
if [ -f "$VALIDATE_SCRIPT" ]; then
  ( bash "$VALIDATE_SCRIPT" > "$TMPD/validate.log" 2>&1; echo $? > "$TMPD/validate.rc" ) &
  VALIDATE_PID=$!
else
  echo 0 > "$TMPD/validate.rc"; VALIDATE_PID=""
fi

# 密钥扫描（DEC-049）：二进制存在则硬失败；缺失则软警告
SECRETS_SCRIPT="$ROOT/scripts/governance/gov-secrets-scan.sh"
if [ -f "$SECRETS_SCRIPT" ]; then
  ( bash "$SECRETS_SCRIPT" > "$TMPD/secrets.log" 2>&1; echo $? > "$TMPD/secrets.rc" ) &
  SECRETS_PID=$!
else
  echo 0 > "$TMPD/secrets.rc"; SECRETS_PID=""
fi

[ -n "$VALIDATE_PID" ] && wait "$VALIDATE_PID" || true
echo -n "  [2/4] 文档校验: "
if [ "$(cat "$TMPD/validate.rc" 2>/dev/null || echo 1)" = "0" ]; then
  echo "✅"
else
  echo "❌"; grep -E "FAIL|违规" "$TMPD/validate.log" | sed 's/^/      /' || true
  FAILED=1
fi

[ -n "$SECRETS_PID" ] && wait "$SECRETS_PID" || true
echo -n "  [3/4] 密钥扫描: "
if [ "$(cat "$TMPD/secrets.rc" 2>/dev/null || echo 1)" = "0" ]; then
  echo "✅"
  grep -E '软警告|未找到 gitleaks|PASS' "$TMPD/secrets.log" | sed 's/^/      /' || true
else
  echo "❌"; tail -40 "$TMPD/secrets.log" | sed 's/^/      /'
  FAILED=1
fi

# DEC-077: --no-verify 审计（默认 warn；GOV_BYPASS_POLICY=block 才阻断）
# explore/docs 模式允许合法 --no-verify（记录审计不阻断）
# 如果 GOV_MODE 环境变量未设置, 从 .ai/current-mode.json 读取 (DEC-077 模式感知)
# DEC-083: 清洗 GOV_MODE 环境变量 —— 宽松模式（explore/docs/test）只能来自 HMAC 签名文件
if [ -f "$ROOT/scripts/governance/gov-mode-lib.sh" ]; then
  # shellcheck source=/dev/null
  . "$ROOT/scripts/governance/gov-mode-lib.sh"
  gov_mode_sanitize_env
fi
if [ -z "${GOV_MODE:-}" ] && [ -f "$ROOT/scripts/governance/gov-mode-lib.sh" ]; then
  # shellcheck source=/dev/null
  . "$ROOT/scripts/governance/gov-mode-lib.sh"
  MODE_VALIDATION="$(gov_mode_validate 2>/dev/null || true)"
  GOV_MODE="$(printf '%s' "$MODE_VALIDATION" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('mode','dev'))" 2>/dev/null)"
  VALID="$(printf '%s' "$MODE_VALIDATION" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('valid',False))" 2>/dev/null)"
  EXPIRED="$(printf '%s' "$MODE_VALIDATION" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('expired',False))" 2>/dev/null)"

  REASON="$(printf '%s' "$MODE_VALIDATION" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('reason',''))" 2>/dev/null)"

  if [ "$VALID" != "True" ]; then
    # 没有模式文件 = 正常态（默认 dev），不是篡改，不该告警（DEC-083）
    if [ "$REASON" != "no mode file" ]; then
      echo "  [WARNING] 模式校验失败（${REASON:-unknown}）, 回退到 dev" >&2
    fi
    GOV_MODE="dev"
  elif [ "$EXPIRED" = "True" ]; then
    echo "  [WARNING] 模式 $GOV_MODE 已过期, 回退到 dev" >&2
    GOV_MODE="dev"
  else
    echo "  ✓ 模式验证通过: $GOV_MODE (session: ${SESSION_ID:-unknown})"
  fi
fi
GOV_MODE="${GOV_MODE:-dev}"
if [ "$GOV_MODE" = "explore" ] || [ "$GOV_MODE" = "docs" ]; then
  echo ""
  echo "  [4/4] 绕过审计 (explore/docs 模式允许合法 --no-verify):"
  BYPASS_MODE="--audit-only"  # 仅记录审计，不阻断
else
  echo ""
  echo "  [4/4] 绕过审计:"
  BYPASS_MODE="${GOV_BYPASS_POLICY:-warn}"
fi

COMMITS=""
if [ -n "$PUSH_INPUT" ]; then
  while read -r _lref lsha _rref rsha; do
    [ -z "${lsha:-}" ] && continue
    case "$lsha" in *0000000000000000000000000000000000000000) continue ;; esac
    if [ -z "${rsha:-}" ] || [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
      # 新分支：只取"远端还没有"的提交，别枚举全史（head + pipefail = SIGPIPE）
      COMMITS="${COMMITS} $(git rev-list --max-count=50 "$lsha" --not --remotes 2>/dev/null)"
    else
      COMMITS="${COMMITS} $(git rev-list --max-count=50 "${rsha}..${lsha}" 2>/dev/null)"
    fi
  done <<< "$PUSH_INPUT"
fi

# DEC-077: 共享文件锁防御 (pre-commit 已检查, 此处为 defense-in-depth)
if [ -n "${COMMITS:-}" ] && [ -f "$ROOT/scripts/workflow/wf-lock.sh" ]; then
  SHARED_REGEX='^(\.ai/tasks\.json|STATUS\.md|tests/android-test-registry\.yaml|docs/ai/lifecycle/03_TaskGraph\.md|docs/ai/lifecycle/06_Metrics\.md|docs/index\.md|AGENTS\.md)$'
  SHARED_IN_PUSH=$(echo "${COMMITS:-}" | tr ' ' '\n' | while read -r sha; do
    git diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null || true
  done | grep -E "$SHARED_REGEX" || true)
  if [ -n "$SHARED_IN_PUSH" ]; then
    SESSION_ID_CURR="$(cat "$ROOT/.ai/current-session.json" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null || true)"
    for f in $SHARED_IN_PUSH; do
      LOCK_STATUS=$(bash "$ROOT/scripts/workflow/wf-lock.sh" file-check "$f" 2>/dev/null || echo "UNLOCKED")
      if ! echo "$LOCK_STATUS" | grep -q "$SESSION_ID_CURR"; then
        echo ""
        echo "  [WARNING] 共享文件 $f 在提交中被修改, 但当前会话未持锁"
        echo "       可能原因: 锁已过期 (默认 240min) 或由其他会话修改"
        echo "       如确有修改权限: bash scripts/workflow/wf-lock.sh file-acquire \"$f\" --mode docs"
      fi
    done
  fi
fi

# shellcheck disable=SC2086
if [ -n "$COMMITS" ]; then
  # BYPASS_MODE 可能已带前缀 (--audit-only) 或不带
  if [ "${BYPASS_MODE#--}" != "$BYPASS_MODE" ]; then
    BYPASS_FLAG="$BYPASS_MODE"
  else
    BYPASS_FLAG="--$BYPASS_MODE"
  fi
  bash "$ROOT/scripts/governance/gov-audit-bypass.sh" --commits $COMMITS "$BYPASS_FLAG" || {
    [ "$BYPASS_MODE" = "block" ] && FAILED=1
  }
else
  if [ "${BYPASS_MODE#--}" != "$BYPASS_MODE" ]; then
    BYPASS_FLAG="$BYPASS_MODE"
  else
    BYPASS_FLAG="--$BYPASS_MODE"
  fi
  bash "$ROOT/scripts/governance/gov-audit-bypass.sh" "$BYPASS_FLAG" || {
    [ "$BYPASS_MODE" = "block" ] && FAILED=1
  }
fi

echo ""
if [ "$FAILED" -ne 0 ]; then
  echo "❌ pre-push 审计未通过，推送被拒绝"
  echo "   临时跳过: git push --no-verify"
  exit 1
fi

echo "=== 全部通过 ==="
exit 0
