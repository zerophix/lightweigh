#!/usr/bin/env bash
# scripts/governance/gov-prepare-commit-msg
# Git prepare-commit-msg hook — 自动注入 Session-Id 与 Task trailer 到 footer
#
# 生效方式：core.hooksPath=scripts/hooks（DEC-073），无需拷贝安装。
#
# Task trailer 是任务归属的第一权威（DEC-073）：
#   提交时若暂存文件命中了某个任务的认领锁，就写入 "Task: T-XXX"，
#   合并队列据此回填任务板，不再依赖分支名。

COMMIT_MSG_FILE="$1"

# ---- 治理总开关（scripts/governance/gov-mode.sh off 时直接放行）----
_gov_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=/dev/null
if [ -f "$_gov_root/scripts/governance/gov-mode.sh" ]; then
  . "$_gov_root/scripts/governance/gov-mode.sh"
  if gov_mode_is_off; then
    gov_mode_audit_skip "prepare-commit-msg"
    exit 0
  fi
fi
COMMIT_SOURCE="$2"
SHA1="$3"

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
SESSION_FILE="$ROOT/.ai/current-session.json"

# 读取当前会话 ID
SESSION_ID=""
if [ -f "$SESSION_FILE" ]; then
  SESSION_ID=$(python3 -c "
import json
with open('$SESSION_FILE') as f:
    d = json.load(f)
print(d.get('session_id', ''))
" 2>/dev/null)
fi

# 如果没有会话 ID 或是 merge/amend，不注入
if [ -z "$SESSION_ID" ] || [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
  exit 0
fi

# 检查是否已有 Session-Id
if grep -q "^Session-Id:" "$COMMIT_MSG_FILE"; then
  exit 0
fi

# 注入 Session-Id 到 footer
echo "" >> "$COMMIT_MSG_FILE"
echo "Session-Id: $SESSION_ID" >> "$COMMIT_MSG_FILE"

# 注入 Task trailer：暂存文件 + 认领锁 → 任务号（可能多个）
if ! grep -q "^Task:" "$COMMIT_MSG_FILE"; then
  TASKS="$(cd "$ROOT" && python3 - <<'PY' 2>/dev/null
import json, subprocess, sys
from pathlib import Path

root = Path.cwd()
locks = root / ".ai" / "locks"
if not locks.is_dir():
    sys.exit(0)

# 只认「本次会话自己持有」的锁：历史遗留锁不能给每次提交都打上任务号。
try:
    session = json.loads((root / ".ai" / "current-session.json").read_text(encoding="utf-8")).get("session_id") or ""
except Exception:
    session = ""

staged = subprocess.run(["git", "diff", "--cached", "--name-only"],
                        capture_output=True, text=True).stdout.split()
if not staged:
    sys.exit(0)

try:
    tasks = {t["id"]: t for t in json.loads((root / ".ai" / "tasks.json").read_text(encoding="utf-8"))["tasks"]}
except Exception:
    tasks = {}

hit = []
for lock in sorted(locks.iterdir()):
    if not lock.is_dir() or not lock.name.startswith("T-"):
        continue
    owner = ""
    try:
        owner = (lock / "owner").read_text(encoding="utf-8").strip()
    except OSError:
        pass
    if session and owner and owner != session:
        continue
    targets = [str(t) for t in (tasks.get(lock.name, {}).get("target_files") or [])]
    if not targets:
        continue
    for f in staged:
        if any(f == t or f.startswith(t.rstrip("/") + "/") for t in targets):
            hit.append(lock.name)
            break
print(" ".join(sorted(set(hit))))
PY
)"
  if [ -n "${TASKS:-}" ]; then
    for t in $TASKS; do
      echo "Task: $t" >> "$COMMIT_MSG_FILE"
    done
  fi
fi

exit 0