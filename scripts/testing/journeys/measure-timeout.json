{
  "name": "测量超时后可重测",
  "steps": [
    {"name": "启动进入登录门", "expect": ["轻刻健康"]},
    {"name": "同意隐私", "tap": "我已阅读并同意"},
    {"name": "游客进入", "tap": "游客进入", "wait": 2.0, "expect": ["首页"]},
    {"name": "开始测量", "tap": "开始第一次测量", "wait": 1.5, "expect": ["测量前检查"]},
    {"name": "确认秤面", "tap": "秤面干燥平整"},
    {"name": "下一步", "tap": "确认，下一步", "expect": ["测量准备"]},
    {"name": "准备好了", "tap": "我准备好了", "expect": ["测量中"]},
    {"name": "触发超时", "tap": "超时", "expect": ["测量超时"]},
    {"name": "重新测量", "tap": "重新测量", "expect": ["测量中"]}
  ]
}
