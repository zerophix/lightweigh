{
  "name": "邀请家人并撤销共享",
  "steps": [
    {"name": "启动进入登录门", "expect": ["轻刻健康"]},
    {"name": "同意隐私", "tap": "我已阅读并同意"},
    {"name": "游客进入", "tap": "游客进入", "wait": 2.0, "expect": ["首页"]},
    {"name": "我的", "tap": "我的", "wait": 1.5, "expect": ["你的健康档案"]},
    {"name": "测量用户（成员页）", "tap": "测量用户", "wait": 1.5, "expect": ["邀请家人加入", "管理共享权限"]},
    {"name": "邀请家人加入", "tap": "邀请家人加入", "wait": 1.2, "expect": ["邀请码", "共享权限设置"]},
    {"name": "发送邀请", "tap": "发送邀请", "wait": 1.2, "expect": ["邀请已发送", "待接受"]},
    {"name": "返回家庭共享", "tap": "返回家庭共享", "wait": 1.2, "expect": ["管理共享权限"]},
    {"name": "管理共享权限", "tap": "管理共享权限", "wait": 1.2, "expect": ["撤销全部共享"]},
    {"name": "撤销全部共享", "tap": "撤销全部共享", "expect": ["确认撤销"]},
    {"name": "确认撤销", "tap": "确认撤销", "wait": 1.5, "expect": ["行动计划"]}
  ]
}
