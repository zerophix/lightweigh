{
  "name": "首次启动到测量完成",
  "steps": [
    {"name": "启动进入登录门", "expect": ["轻刻健康", "我已阅读并同意"]},
    {"name": "同意隐私协议", "tap": "我已阅读并同意"},
    {"name": "游客进入", "tap": "游客进入", "wait": 2.0, "expect": ["首页", "开始第一次测量"]},
    {"name": "开始第一次测量", "tap": "开始第一次测量", "wait": 1.5, "expect": ["测量前检查"]},
    {"name": "确认秤面", "tap": "秤面干燥平整"},
    {"name": "确认，下一步", "tap": "确认，下一步", "expect": ["测量准备"]},
    {"name": "我准备好了", "tap": "我准备好了", "expect": ["测量中"]},
    {"name": "读数稳定", "tap": "稳定了", "expect": ["正在计算身体成分"]},
    {"name": "保存成功", "tap": "完成 → 保存成功", "wait": 1.5, "expect": ["已保存"]},
    {"name": "完成回首页", "tap": "完成", "wait": 1.5, "expect": ["首页"]}
  ]
}
