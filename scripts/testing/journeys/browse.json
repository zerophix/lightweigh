{
  "name": "browse-mine-trend-device",
  "steps": [
    {
      "name": "启动进入登录门",
      "expect": [
        "轻衡健康",
        "我已阅读并同意"
      ]
    },
    {
      "name": "同意隐私协议",
      "tap": "我已阅读并同意"
    },
    {
      "name": "游客进入",
      "tap": "游客进入",
      "wait": 2.0,
      "expect": [
        "首页"
      ]
    },
    {
      "name": "我的",
      "tap": "我的",
      "wait": 1.5,
      "expect": [
        "你的健康档案"
      ]
    },
    {
      "name": "上滑露出更多入口",
      "scroll": "up"
    },
    {
      "name": "历史记录",
      "tap": "历史记录",
      "wait": 1.5,
      "expect": [
        "历史记录",
        "对比"
      ]
    },
    {
      "name": "返回",
      "back": true,
      "expect": [
        "你的健康档案"
      ]
    },
    {
      "name": "趋势",
      "tap": "趋势",
      "wait": 1.5,
      "expect": [
        "看见每一步改变"
      ]
    },
    {
      "name": "设备",
      "tap": "设备",
      "wait": 2.0
    },
    {
      "name": "授权（首次会弹系统框）",
      "tap": "Allow",
      "optional": true,
      "wait": 2.0
    },
    {
      "name": "设备页可用",
      "expect": [
        "连接帮助",
        "扫码绑定"
      ]
    },
    {
      "name": "配对流程可见",
      "expect": [
        "开启蓝牙"
      ]
    }
  ]
}
